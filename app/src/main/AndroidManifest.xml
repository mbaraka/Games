<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Train Survivor co-op: classic Bluetooth between two paired phones -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <application
        android:name=".GameApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Game"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Game">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Base Defender's activity entry lives in its own module now (games/basedefender/src/main/AndroidManifest.xml); manifest merging pulls it in automatically. -->

        <!-- Memory Match's activity entry lives in its own module now (games/memorymatch/src/main/AndroidManifest.xml); manifest merging pulls it in automatically. -->

        <activity
            android:name=".numbercruncher.NumberCruncherGame"
            android:exported="false"
            android:label="Number Cruncher"
            android:theme="@style/Theme.Game" />

        <!-- Train Survivor's activity entry lives in its own module now (games/trainsurvivor/src/main/AndroidManifest.xml); manifest merging pulls it in automatically. -->

        <!-- Dreadnought's activity entry lives in its own module now (games/dreadnought/src/main/AndroidManifest.xml); manifest merging pulls it in automatically. -->

        <!-- Key Reader's activity entry lives in its own module now (games/keyreader/src/main/AndroidManifest.xml); manifest merging pulls it in automatically. -->

        <activity
            android:name=".licenses.OpenSourceLicensesActivity"
            android:exported="false"
            android:label="Open Source Licenses"
            android:theme="@style/Theme.Game" />

        <!-- Snakes & Ladders' activity entry lives in its own module now (games/snakeladder/src/main/AndroidManifest.xml); manifest merging pulls it in automatically. -->

        <!-- Battleship's activity entry lives in its own module now (games/battleship/src/main/AndroidManifest.xml); manifest merging pulls it in automatically. -->

        <activity
            android:name=".knightsurvivor.KnightSurvivorActivity"
            android:exported="false"
            android:label="Knight Survivor"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".clashdecks.ClashDecksActivity"
            android:exported="false"
            android:label="Clash Decks"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <!-- Minesweeper's activity entry lives in its own module now (games/minesweeper/src/main/AndroidManifest.xml); manifest merging pulls it in automatically. -->

        <activity
            android:name=".numbercorridor.NumberCorridorActivity"
            android:exported="false"
            android:label="Number Corridor"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <!-- Road Rush's activity entry lives in its own module now (games/roadrush/src/main/AndroidManifest.xml); manifest merging pulls it in automatically. -->

        <activity
            android:name=".breakout.BreakoutActivity"
            android:exported="false"
            android:label="Brick Blitz"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".spaceinvaders.SpaceInvadersActivity"
            android:exported="false"
            android:label="Star Invasion"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".missilecommand.MissileCommandActivity"
            android:exported="false"
            android:label="Silo Defense"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <!-- Snake's activity entry lives in its own module now (games/snake/src/main/AndroidManifest.xml); manifest merging pulls it in automatically. -->

        <activity
            android:name=".asteroids.AsteroidsActivity"
            android:exported="false"
            android:label="Rock Blaster"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <!-- Tunnel Crew's activity entry lives in its own module now (games/tunnelcrew/src/main/AndroidManifest.xml); manifest merging pulls it in automatically. -->

        <activity
            android:name=".cratecrew.CrateCrewActivity"
            android:exported="false"
            android:label="Crate Crew"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <!-- Arc Shot's activity entry lives in its own module now (games/arcshot/src/main/AndroidManifest.xml); manifest merging pulls it in automatically. -->
    </application>

</manifest>
