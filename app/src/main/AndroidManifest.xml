<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Train Survivor co-op: classic Bluetooth between two paired phones -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <application
        android:name=".GameApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Game"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Game">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".basedefender.BaseDefenderGame"
            android:exported="false"
            android:label="Base Defender"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".memorymatch.MemoryMatchGame"
            android:exported="false"
            android:label="Memory Match"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".numbercruncher.NumberCruncherGame"
            android:exported="false"
            android:label="Number Cruncher"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".trainsurvivor.TrainSurvivorActivity"
            android:exported="false"
            android:label="Train Survivor"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".dreadnought.DreadnoughtActivity"
            android:exported="false"
            android:label="Dreadnought"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".keyreader.KeyReaderActivity"
            android:exported="false"
            android:label="Key Reader"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".licenses.OpenSourceLicensesActivity"
            android:exported="false"
            android:label="Open Source Licenses"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".snakeladder.SnakeLadderActivity"
            android:exported="false"
            android:label="Snakes &amp; Ladders"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".battleship.BattleShipActivity"
            android:exported="false"
            android:label="Fleet Duel"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".knightsurvivor.KnightSurvivorActivity"
            android:exported="false"
            android:label="Knight Survivor"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".clashdecks.ClashDecksActivity"
            android:exported="false"
            android:label="Clash Decks"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".minesweeper.MinesweeperActivity"
            android:exported="false"
            android:label="Minesweeper"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".numbercorridor.NumberCorridorActivity"
            android:exported="false"
            android:label="Number Corridor"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".roadrush.RoadRushActivity"
            android:exported="false"
            android:label="Road Rush"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".breakout.BreakoutActivity"
            android:exported="false"
            android:label="Brick Blitz"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".spaceinvaders.SpaceInvadersActivity"
            android:exported="false"
            android:label="Star Invasion"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".missilecommand.MissileCommandActivity"
            android:exported="false"
            android:label="Silo Defense"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".snake.SnakeActivity"
            android:exported="false"
            android:label="Snake"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".asteroids.AsteroidsActivity"
            android:exported="false"
            android:label="Rock Blaster"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".tunnelcrew.TunnelCrewActivity"
            android:exported="false"
            android:label="Tunnel Crew"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".cratecrew.CrateCrewActivity"
            android:exported="false"
            android:label="Crate Crew"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Game" />

        <activity
            android:name=".arcshot.ArcShotActivity"
            android:exported="false"
            android:label="Arc Shot"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Game" />
    </application>

</manifest>
